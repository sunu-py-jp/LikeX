import assert from 'node:assert/strict';
import { notifyHost, resolveFeatureFlags, chainResult, createUnsavedChangesGuard, createTextSearchMatcher, openContextMenu } from '__LIBRARY_IMPORT__';
import { openContextMenu as openBrowserContextMenu } from '__LIBRARY_IMPORT__/browser';
import { createTextSearchMatcher as createSubpathTextSearchMatcher } from '__LIBRARY_IMPORT__/text-search';

assert.equal(typeof globalThis.window, 'undefined');
assert.equal(typeof globalThis.document, 'undefined');
assert.equal(openContextMenu, openBrowserContextMenu, 'Root and subpath share the menu implementation and active-menu registry');
assert.deepEqual(resolveFeatureFlags({ edit: true }, { edit: false }), { edit: false });
assert.equal(chainResult(2, value => value * 3), 6);
assert.equal(await chainResult(Promise.resolve(2), value => value * 3), 6);
assert.doesNotThrow(() => notifyHost(() => { throw new Error('observer only'); }));
assert.doesNotThrow(() => createUnsavedChangesGuard().register(undefined)());
assert.equal(createTextSearchMatcher({ text: '^sales-\\d+$', useRegex: true }).test('Sales-2026'), true);
assert.equal(createSubpathTextSearchMatcher({ text: '^sales-\\d+$', useRegex: true }).replace('Sales-2026', '$1'), '$1');
console.log(JSON.stringify({ resolved: import.meta.resolve('__LIBRARY_RESOLVE__'), nodeImport: true }));
