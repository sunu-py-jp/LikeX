import { notifyHost, resolveFeatureFlags, chainResult, createContextMenuExecutor, resolveContextMenuItems, serializeStableJson } from '__LIBRARY_IMPORT__';
import type { EditRequestHandler, EventHandler, SaveHandler, RequestHandler, MaybePromise, ContextMenuProvider, ContextMenuExecutionMode, StableJsonOptions } from '__LIBRARY_IMPORT__';
import { serializeStableJson as serializeJsonWithoutUi } from '__LIBRARY_IMPORT__/json';
import { getConnectorPortPoint, findNearestConnectorPort, isConnectorArrowhead } from '__LIBRARY_IMPORT__';
import type { ConnectorEndpoint, ConnectorOutline, ConnectorArrowhead } from '__LIBRARY_IMPORT__';
import { createOfficeConnectorGeometry, readOfficeConnectorShapeTag } from '__LIBRARY_IMPORT__/ooxml';

const connectorOutline: ConnectorOutline = { type: 'ellipse' };
const connectorBox = { x: 0, y: 0, width: 120, height: 60, rotation: 30 };
const endpoint: ConnectorEndpoint = { ...getConnectorPortPoint(connectorBox, 'topRight', connectorOutline), binding: { targetId: 'node', port: 'topRight' } };
const arrowhead: ConnectorArrowhead = 'openArrow';
findNearestConnectorPort(endpoint, [{ id: 'node', box: connectorBox, outline: connectorOutline }], 12);
createOfficeConnectorGeometry('ellipse', connectorOutline);
readOfficeConnectorShapeTag(undefined);
isConnectorArrowhead(arrowhead);
// @ts-expect-error Public connection ports are a closed set.
getConnectorPortPoint(connectorBox, 'center');

const jsonOptions: StableJsonOptions = { maxLength: 1024, space: 2, compareKeys: () => 0 };
const stableJson: string = serializeStableJson({ b: 2, a: 1 }, jsonOptions);
// @ts-expect-error Limits are numeric UTF-16 character counts.
serializeStableJson({}, { maxLength: '1024' });
void [stableJson, serializeJsonWithoutUi({ nested: [1, 2] })];

const permission: EditRequestHandler<{ action: string }, readonly string[], 'entries'> =
  (_request, context) => context.signal.aborted ? false : { allowed: true, entries: [] };
const save: SaveHandler<{ id: string }> = async payload => payload;
const request: RequestHandler<{ id: string }, boolean> = (payload, context) => !!payload.id && !context.signal.aborted;
const event: EventHandler<{ type: 'saved' }> = () => {};
notifyHost(event, { type: 'saved' });
const result: MaybePromise<number> = chainResult(1, value => value + 1);
resolveFeatureFlags({ edit: true }, { edit: false });
// @ts-expect-error undeclared feature names must be rejected
resolveFeatureFlags<'edit'>({ edit: true }, { typo: false });
// @ts-expect-error host event payloads stay strict
notifyHost(event, { type: 'unknown' });
void [permission, save, request, result];

const menus: ContextMenuProvider<{ id: string }, { text: string }> = context => [{
  id: 'generate', label: 'Generate', onSelect: async (_context, operation) => {
    if (operation.signal.aborted) return;
    return { change: { text: context.id }, description: 'Update text' };
  },
}];
const items = resolveContextMenuItems(menus, { id: 'file' });
const executor = createContextMenuExecutor<{ id: string }, { text: string }>({
  getRevision: () => 1, prepareChange: change => ({ ...change }),
  apply: (_change, _context, _operation, guard) => { if (!guard.isCurrent()) throw new Error('stale'); },
});
const mode: ContextMenuExecutionMode = 'confirm';
void executor.run(items[0], { id: 'file' }, mode);
// @ts-expect-error component change plans retain their domain type
const invalidMenu: ContextMenuProvider<{ id: string }, { text: string }> = () => [{ id: 'bad', label: 'Bad', onSelect: () => ({ change: 1 }) }];
// @ts-expect-error concurrent execution policy is a closed set
const invalidMode: ContextMenuExecutionMode = 'automatic';
void [invalidMenu, invalidMode];

import { createTextSearchMatcher, type TextSearchQuery } from "__LIBRARY_IMPORT__/text-search";
const searchQuery: TextSearchQuery = { text: "^Sales", useRegex: true, matchCase: false };
const found: boolean = createTextSearchMatcher(searchQuery).test("sales 2026");
void found;
