import assert from "node:assert/strict";
import { createDocument, executeDocumentCommands, getDocumentText, getBlock, getBlocks, getImages,
  serializeDocument, parseDocument, createDocumentSession, importDocumentDocx, exportDocumentDocx, collectDocumentImages } from "__MODEL_IMPORT__";

assert.equal(typeof window, "undefined");
assert.equal(typeof document, "undefined");
const original = createDocument({ title: "Headless document" });
const first = getBlocks(original)[0];
assert.equal(first.contentFrom, 1);
assert.equal(getDocumentText(original), "");
const result = executeDocumentCommands(original, [
  { type: "text.insert", from: 1, text: "Headless content" },
  { type: "mark.set", from: 1, to: 9, mark: "strong", enabled: true },
]);
assert.equal(getDocumentText(original), "", "commands leave the source unchanged");
assert.equal(getDocumentText(result.document), "Headless content");
assert.equal(getBlock(result.document, first.id).contentTo, 17);
assert.deepEqual(getImages(result.document), []);
assert.deepEqual(await collectDocumentImages(result.document), { images: [], placements: [] });
const pixel = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+j6xkAAAAASUVORK5CYII=';
const imageDocument = createDocument({ content: { type: 'doc', content: [
  { type: 'image', attrs: { id: 'small', src: pixel, width: 20, height: 20 } },
  { type: 'image', attrs: { id: 'large', src: pixel, width: 100, height: 100 } },
] } });
const collected = await collectDocumentImages(imageDocument);
assert.equal(collected.images.length, 1); assert.match(collected.images[0].imageId, /^sha256:[a-f0-9]{64}$/);
assert.deepEqual(collected.placements.map(({ blockId, width }) => ({ blockId, width })), [{ blockId: 'small', width: 20 }, { blockId: 'large', width: 100 }]);
assert.deepEqual(parseDocument(serializeDocument(result.document)), result.document);
assert.equal(serializeDocument(parseDocument(serializeDocument(result.document))), serializeDocument(result.document));
assert.throws(() => parseDocument(JSON.stringify({ ...result.document, version: 2 })));
assert.throws(() => parseDocument(JSON.stringify({ ...result.document, format: "likex.slide" })));
const snapshot = serializeDocument(result.document);
assert.throws(() => executeDocumentCommands(result.document, [
  { type: "document.update", title: "Must not persist" }, { type: "text.delete", from: -1, to: 100 },
]));
assert.equal(serializeDocument(result.document), snapshot);

const session = createDocumentSession(original);
session.execute({ type: "document.update", title: "Saved title" });
session.markSaved();
assert.equal(session.undo(), true);
assert.equal(session.getSnapshot().dirty, true);
assert.equal(session.redo(), true);
assert.equal(session.getSnapshot().dirty, false);
const exported = await exportDocumentDocx(result.document);
assert.equal(typeof exported.blob.arrayBuffer, "function");
const imported = await importDocumentDocx(exported.blob);
assert.equal(getDocumentText(imported.document), "Headless content");
assert.deepEqual(exported.warnings, []);
assert.deepEqual(imported.warnings, []);
console.log(JSON.stringify({ noReact: true, noDOM: true, commandsAndHistory: "passed", nativeRoundtrip: "passed", officeRoundtrip: "passed" }));
