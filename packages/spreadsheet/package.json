{
  "name": "@likex/spreadsheet",
  "version": "0.1.0",
  "description": "An independent React spreadsheet with local editing, formulas, and host-owned persistence.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/types/model-entry.d.ts",
      "import": "./dist/model.js",
      "default": "./dist/model.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "src/README.md",
    "src/docs/*.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "scripts": {
    "build": "node ../../scripts/build-library.mjs --module spreadsheet",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "node ../../scripts/build-library.mjs --module core",
    "pretypecheck": "node ../../scripts/build-library.mjs --module core"
  },
  "keywords": [
    "react",
    "spreadsheet",
    "typescript",
    "formulas"
  ],
  "dependencies": {
    "@likex/core": "0.1.0"
  }
}
