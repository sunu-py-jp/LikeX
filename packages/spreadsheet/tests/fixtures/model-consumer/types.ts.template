function drawingPosition(workbook: SpreadsheetWorkbookSnapshot, sheetId: string, drawingId: string) {
  const placement = getDrawingPlacement(workbook, sheetId, drawingId, { gap: 12 });
  const bottom: number = getDrawingBounds(workbook, sheetId, drawingId).bottom;
  // @ts-expect-error Computed bounds cannot be mutated.
  placement.bounds.top = 0;
  return { row: placement.nextRow, column: placement.nextColumn, bottom };
}
void drawingPosition;

