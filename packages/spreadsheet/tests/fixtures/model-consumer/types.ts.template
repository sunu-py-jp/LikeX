async function readExcel(bytes: Uint8Array, signal?: SpreadsheetExcelImportOptions['signal']) {
  const options: SpreadsheetExcelImportOptions = { signal };
  const imported: SpreadsheetExcelImportResult = await importSpreadsheetXlsx(bytes, options);
  const warning: string | undefined = imported.warnings[0]?.message;
  // @ts-expect-error Warning collections are readonly.
  imported.warnings.push({ code: 'omitted', message: 'x' });
  return [imported.workbook, warning];
}
void readExcel;

async function writeExcel() {
  const options: SpreadsheetXlsxExportOptions = { rasterizeImage: async request => {
    const bytes: ArrayBuffer = await request.source.arrayBuffer();
    const resourceId: string = request.resourceId;
    void [bytes, resourceId];
    throw new Error('The host converts the input into a PNG');
  } };
  const file = await exportSpreadsheetXlsx(createWorkbook(), options);
  const bytes: ArrayBuffer = await file.arrayBuffer();
  const mime: string = file.type;
  return { bytes, mime };
}
void writeExcel;

