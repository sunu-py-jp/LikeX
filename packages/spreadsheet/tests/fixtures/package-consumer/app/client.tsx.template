"use client";

import { useRef, useState } from "react";
import Spreadsheet, { createWorkbook, type SpreadsheetWorkbook, type SpreadsheetProps, type SpreadsheetHandle } from "__LIBRARY_IMPORT__";

export default function ClientSpreadsheet() {
  const [saved, setSaved] = useState<SpreadsheetWorkbook>(() => createWorkbook());
  const spreadsheet = useRef<SpreadsheetHandle>(null);
  const props = {
    initialWorkbook: saved,
    onSave: async (workbook, context) => { void context.signal; setSaved(workbook); return workbook; },
    onBeforeSave: workbook => workbook.sheets.length > 0,
    onEditRequest: async (_request, context) => !context.signal.aborted,
    onRefresh: async () => saved,
    onEvent: event => { if (event.type === "save" && event.status === "success") void event.requestId; },
    onSelectionChange: selection => { void selection.focus.row; },
    contextMenuExecutionMode: "reject-if-changed",
    getContextMenuItems: context => [{ id: "sample-menu", label: "Set formula",
      onSelect: async (_captured, { signal }) => {
        if (signal.aborted) return;
        return { description: "Set a formula", change: [{ type: "cells.set",
          sheetId: context.target.sheetId, values: { [context.target.address]: "=SUM(1,2)" } }] };
      },
    }],
    features: { clipboard: false, formatting: true, undoRedo: true },
    colorMode: "system",
    title: "Editable spreadsheet",
    style: { height: 360 },
  } satisfies SpreadsheetProps;
  return <><button onClick={() => {
    const api = spreadsheet.current;
    if (api) void api.executeAsync({ type: "cells.set", sheetId: api.getWorkbook().sheets[0].id, values: { A1: "External API" } });
  }}>Set sample value</button><Spreadsheet ref={spreadsheet} {...props} /></>;
}
