import Spreadsheet, {
  createWorkbook, setCellValue, calculateWorkbook, parseTsv, stringifyTsv,
  serializeWorkbook, parseWorkbook, addDrawing, setCellComment, mergeCells, unmergeCells,
  type SpreadsheetWorkbook, type SpreadsheetSheet, type SpreadsheetCell,
  type SpreadsheetCellFormat, type SpreadsheetCellPosition, type SpreadsheetProps,
  type SpreadsheetFeatures, type SpreadsheetSelection, type SpreadsheetSelectionRange, type SpreadsheetSaveHandler,
  type SpreadsheetDrawing, type SpreadsheetMergedRange,
} from "__LIBRARY_IMPORT__";

const workbook: SpreadsheetWorkbook = createWorkbook();
const sheet: SpreadsheetSheet = workbook.sheets[0];
const cell: SpreadsheetCell = { value: "=SUM(A1:A3)", format: { bold: true, numberFormat: "number" } };
const format: SpreadsheetCellFormat = { align: "right", color: "#123456" };
const position: SpreadsheetCellPosition = { row: 0, column: 1 };
const populated = setCellValue(workbook, sheet.id, "A1", "42");
const calculated = calculateWorkbook(populated);
const save: SpreadsheetSaveHandler = next => next;
const asyncSave: SpreadsheetSaveHandler = async next => next;
const notifySave: SpreadsheetSaveHandler = () => {};
const props = {
  initialWorkbook: populated,
  onSave: save,
  onChange(next: SpreadsheetWorkbook) { void next.sheets; },
  onSelectionChange(selection: SpreadsheetSelection) {
    const selectedSheet: string = selection.sheetId;
    const row: number = selection.focus.row;
    const ranges: readonly SpreadsheetSelectionRange[] = selection.ranges ?? [selection];
    void [selectedSheet, row, ranges];
  },
  features: { formulas: true, clipboard: false, formatting: false, sheets: true, images: true, shapes: false, comments: true, textBoxes: true, mergeCells: true },
  colorMode: "system",
  style: { height: 400 },
} satisfies SpreadsheetProps;
const editable = <Spreadsheet {...props} />;
const readOnly = <Spreadsheet initialWorkbook={populated} />;
const empty = <Spreadsheet />;
// @ts-expect-error Cell input is a string, including numeric and formula input.
const numericCell = { value: 123 } satisfies SpreadsheetCell;
// @ts-expect-error The feature set is closed; unsupported Excel features are not props.
const unsupported = { pivotTables: true } satisfies SpreadsheetFeatures;
// @ts-expect-error A saved result must be a workbook or void.
const invalidSave: SpreadsheetSaveHandler = async () => 123;
// @ts-expect-error Alignment is a defined union.
const invalidFormat = { align: "justify" } satisfies SpreadsheetCellFormat;
function rejectMutation(next: SpreadsheetWorkbook, selection: SpreadsheetSelection) {
  // @ts-expect-error Sheet collections are readonly snapshots.
  next.sheets.push(sheet);
  // @ts-expect-error Selection identity cannot be replaced by the host callback.
  selection.sheetId = "other";
  // @ts-expect-error Selection range collections are readonly.
  selection.ranges?.push({ anchor: position, focus: position });
  if (selection.ranges?.[0]) {
    // @ts-expect-error Nested positions are readonly too.
    selection.ranges[0].focus.row = 2;
  }
}
void [cell, format, position, calculated, asyncSave, notifySave, editable, readOnly, empty,
  numericCell, unsupported, invalidSave, invalidFormat, rejectMutation, stringifyTsv(parseTsv("a\tb"))];

const drawing: SpreadsheetDrawing = { id: "note", type: "text", text: "JSONメモ", fontSize: 16,
  color: "#333333", background: "transparent", anchor: { row: 1, column: 1, offsetX: 0, offsetY: 0 }, width: 200, height: 100 };
const annotated = setCellComment(addDrawing(populated, sheet.id, drawing), sheet.id, "A1", { id: "comment", text: "確認済み" });
const serialized: string = serializeWorkbook(annotated);
const restored: SpreadsheetWorkbook = parseWorkbook(serialized);
void restored;

const mergedRange: SpreadsheetMergedRange = { top: 2, left: 0, bottom: 3, right: 2 };
const merged: SpreadsheetWorkbook = mergeCells(restored, sheet.id, mergedRange);
const separated: SpreadsheetWorkbook = unmergeCells(merged, sheet.id, mergedRange);
// @ts-expect-error Merged positions cannot be changed through public snapshots.
mergedRange.bottom = 5;
// @ts-expect-error Merge collections are readonly.
merged.sheets[0].merges?.push(mergedRange);
void separated;
