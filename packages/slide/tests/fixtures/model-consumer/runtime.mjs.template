import assert from "node:assert/strict";
import { createSlideDeck, applySlideCommands, getSlide, getElement, serializeSlideDeck, parseSlideDeck, createSlideSession, importSlidePptx, exportSlidePptx } from "__MODEL_IMPORT__";
assert.equal(typeof window, "undefined");
const original = createSlideDeck();
assert.equal(original.format, "likex.slide");
const { format, ...legacy } = original;
assert.throws(() => parseSlideDeck(JSON.stringify(legacy)));
const result = applySlideCommands(original, { type: "element.add", slideId: original.slides[0].id, element: { type: "text", id: "title", text: "Headless content" } });
assert.equal(original.slides[0].elements.length, 0);
assert.equal(getElement(result.deck, original.slides[0].id, "title").text, "Headless content");
assert.equal(getSlide(result.deck, original.slides[0].id).elements.length, 1);
assert.deepEqual(parseSlideDeck(serializeSlideDeck(result.deck)), result.deck);
const nativeFile = JSON.parse(serializeSlideDeck(result.deck));
assert.equal(nativeFile.version, 1);
assert.equal(nativeFile.slides[0].elements[0].stackOrder, 0);
assert.throws(() => parseSlideDeck(JSON.stringify({ ...nativeFile, version: 2 })));
assert.throws(() => parseSlideDeck(JSON.stringify(result.deck)));
assert.equal(result.deck.version, 1);
const session = createSlideSession(original);
session.execute({ type: "deck.rename", title: "Changed" }); session.markSaved();
assert.equal(session.undo(), true); assert.equal(session.getSnapshot().dirty, true);
assert.equal(session.redo(), true); assert.equal(session.getSnapshot().dirty, false);
const pptx = await exportSlidePptx(result.deck);
assert.ok(pptx instanceof Blob);
const imported = await importSlidePptx(pptx);
assert.equal(imported.deck.slides[0].elements[0].text, "Headless content");
assert.deepEqual(imported.warnings, []);
console.log(JSON.stringify({ noReact: true, noDOM: true, commandsAndHistory: "passed", officeRoundtrip: "passed" }));
