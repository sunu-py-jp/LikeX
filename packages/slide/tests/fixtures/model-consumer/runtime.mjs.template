import assert from "node:assert/strict";
import { createSlideDeck, applySlideCommands, getSlide, getElement, serializeSlideDeck, parseSlideDeck, createSlideSession, importSlidePptx, exportSlidePptx } from "__MODEL_IMPORT__";
assert.equal(typeof window, "undefined");
const original = createSlideDeck();
assert.equal(original.format, "likex.slide");
const { format, ...legacy } = original;
assert.throws(() => parseSlideDeck(JSON.stringify(legacy)));
const result = applySlideCommands(original, { type: "element.add", slideId: original.slides[0].id, element: { type: "text", id: "title", text: "Headless content" } });
assert.equal(original.slides[0].elements.length, 0);
assert.equal(getElement(result.deck, original.slides[0].id, "title").text, "Headless content");
assert.equal(getSlide(result.deck, original.slides[0].id).elements.length, 1);
assert.deepEqual(parseSlideDeck(serializeSlideDeck(result.deck)), result.deck);
const nativeFile = JSON.parse(serializeSlideDeck(result.deck));
assert.equal(nativeFile.version, 1);
assert.equal(nativeFile.slides[0].elements[0].stackOrder, 0);
assert.throws(() => parseSlideDeck(JSON.stringify({ ...nativeFile, version: 2 })));
assert.throws(() => parseSlideDeck(JSON.stringify(result.deck)));
assert.equal(result.deck.version, 1);
const session = createSlideSession(original);
session.execute({ type: "deck.rename", title: "Changed" }); session.markSaved();
assert.equal(session.undo(), true); assert.equal(session.getSnapshot().dirty, true);
assert.equal(session.redo(), true); assert.equal(session.getSnapshot().dirty, false);
const pptx = await exportSlidePptx(result.deck);
assert.ok(pptx instanceof Blob);
const imported = await importSlidePptx(pptx);
assert.equal(imported.deck.slides[0].elements[0].text, "Headless content");
assert.deepEqual(imported.warnings, []);
console.log(JSON.stringify({ noReact: true, noDOM: true, commandsAndHistory: "passed", officeRoundtrip: "passed" }));

const mastersApi = await import('__MODEL_IMPORT__');
const masterLibrary = (await mastersApi.importSlidePptxMasters(pptx)).library;
const withMasters = applySlideCommands(result.deck, { type: 'masters.import', library: masterLibrary });
assert.ok(mastersApi.getSlideMasters(withMasters.deck).length > 0);
const layout = mastersApi.getSlideLayouts(withMasters.deck)[0];
const withLayout = applySlideCommands(withMasters.deck, { type: 'slide.applyLayout', slideId: original.slides[0].id, layoutId: layout.id }).deck;
assert.equal(withLayout.slides[0].layoutId, layout.id);
assert.equal(mastersApi.resolveSlideAppearance(withLayout, withLayout.slides[0]).localElements[0].text, 'Headless content');
assert.deepEqual(parseSlideDeck(serializeSlideDeck(withLayout)), withLayout);

const freeformApi = await import('__MODEL_IMPORT__');
const svgSource = freeformApi.createSlideSvgSource('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 90"><path d="M0 90L80 0L160 90Z" fill="#315bfb"/></svg>');
const freeformSession = createSlideSession(original);
freeformSession.execute({ type: 'element.add', slideId: original.slides[0].id, element: { type: 'image', id: 'svg-illustration', src: svgSource, alt: 'Authored illustration', x: 93, y: 117, width: 640, height: 360 } });
const freelyAuthored = freeformSession.getSnapshot().deck;
assert.equal(getElement(freelyAuthored, original.slides[0].id, 'svg-illustration').x, 93);
assert.equal(getElement(freelyAuthored, original.slides[0].id, 'svg-illustration').src, svgSource);
assert.deepEqual(parseSlideDeck(serializeSlideDeck(freelyAuthored)), freelyAuthored);
assert.equal(freeformSession.undo(), true);
assert.equal(freeformSession.getSnapshot().deck.slides[0].elements.length, 0);
assert.equal(freeformSession.redo(), true);
assert.equal(freeformSession.getSnapshot().deck.slides[0].elements[0].src, svgSource);
assert.equal('composeSlideContent' in freeformApi, false);
assert.equal('getSlideCompositionLayouts' in freeformApi, false);
assert.equal(original.slides[0].elements.length, 0);
