import assert from "node:assert/strict";
import { createTextEditorModel, executeTextEditorCommands, parseTextEditorModel, serializeTextEditorModel, findTextEditorMatches, applyMarkdownCommand, applyMarkdownTaskCommand, getTextEditorMarkdownBlocks, decodeTextEditorBytes, resolveTextEditorMode, importTextEditorText, formatTextEditorSource, validateTextEditorSource } from "__MODEL_IMPORT__";
const initial = createTextEditorModel({ id: "consumer", text: "hello hello" });
const document = executeTextEditorCommands(initial, [{ type: "text.replaceAll", query: "hello", replacement: "world", wholeWord: true }]);
assert.equal(typeof window, "undefined");
assert.equal(document.text, "world world");
assert.deepEqual(findTextEditorMatches(document, { query: "world" }), [{ from: 0, to: 5 }, { from: 6, to: 11 }]);
assert.deepEqual(parseTextEditorModel(serializeTextEditorModel(document)), document);
assert.equal(applyMarkdownCommand("hello", { from: 1, to: 6 }, "markdown.bold").text, "**hello**");
assert.equal(decodeTextEditorBytes(new Uint8Array([0x93, 0xfa, 0x96, 0x7b])), "日本");
const multi = executeTextEditorCommands(initial, { type: "text.replaceRanges", edits: [
  { from: 6, to: 11, text: "second" }, { from: 0, to: 5, text: "first" },
] });
assert.equal(multi.text, "first second");
assert.equal(initial.text, "hello hello");
const markdown = createTextEditorModel({ id: "markdown-consumer", mode: "markdown", text: "Hello\n\n- [ ] Pending" });
const blocks = getTextEditorMarkdownBlocks(markdown);
const paragraph = blocks.find(block => block.type === "paragraph" && block.text === "Hello");
const task = blocks.find(block => block.checked === false);
assert.ok(task && paragraph);
const rich = executeTextEditorCommands(markdown, [
  { type: "markdown.format", action: "markdown.bold", selection: { from: paragraph.from, to: paragraph.to } },
  { type: "markdown.toggleTask", position: task.position },
]);
assert.equal(rich.text, "**Hello**\n\n* [x] Pending");
assert.equal(getTextEditorMarkdownBlocks(rich).find(block => block.checked !== undefined).checked, true);
assert.equal(getTextEditorMarkdownBlocks(applyMarkdownTaskCommand(rich.text, task.position).text).find(block => block.checked !== undefined).checked, false);
assert.throws(() => executeTextEditorCommands(markdown, { type: "markdown.toggleTask", position: paragraph.position }), /チェックリスト/);
assert.equal(markdown.text, "Hello\n\n- [ ] Pending");
const textMode = executeTextEditorCommands({ ...markdown, mode: "text" }, {
  type: "markdown.format", action: "markdown.heading2", selection: { from: paragraph.from, to: paragraph.to },
});
assert.equal(textMode.mode, "text");
assert.equal(getTextEditorMarkdownBlocks(textMode)[0].level, 2);
assert.equal(resolveTextEditorMode({ fileName: "settings.JSON", mimeType: "text/plain" }), "json");
assert.equal(resolveTextEditorMode({ mimeType: "application/ld+json" }), "json");
assert.equal(resolveTextEditorMode({ mode: "text", fileName: "settings.json" }), "text");
assert.equal(formatTextEditorSource('{"n":900719925474099312345}', { fileName: "data.json" }).text, '{\n  "n": 900719925474099312345\n}');
assert.equal(validateTextEditorSource('{"n":}', { mode: "json" })[0].line, 1);
assert.equal(executeTextEditorCommands(createTextEditorModel({ mode: "json", text: '{"x":1}' }), { type: "text.format" }).text, '{\n  "x": 1\n}');
assert.equal(formatTextEditorSource('<root><x/></root>', { mode: "xml" }).text, '<root>\n  <x/>\n</root>');
assert.equal(formatTextEditorSource('root:\n    value: 1\n', { mode: "yaml" }).text, 'root:\n  value: 1\n');
const yaml = importTextEditorText("enabled: true\r\n", { fileName: "settings.yml", mode: "auto" });
assert.equal(yaml.mode, "yaml"); assert.equal(yaml.text, "enabled: true\r\n");
for (const mode of ["json", "xml", "yaml"]) {
  const model = createTextEditorModel({ id: "syntax-consumer", text: "  unchanged\r\n", mode });
  assert.deepEqual(parseTextEditorModel(serializeTextEditorModel(model)), model);
}
console.log(JSON.stringify({ headless: "passed", characters: document.text.length }));
