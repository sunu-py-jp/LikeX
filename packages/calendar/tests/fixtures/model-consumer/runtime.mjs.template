import assert from "node:assert/strict";
import { createCalendar, executeCalendarCommands, parseCalendar, serializeCalendar, getCalendarEvents, getCalendarVisibleRange, createCalendarRescheduleCommand } from "__MODEL_IMPORT__";
assert.equal(typeof window, "undefined"); assert.equal(typeof document, "undefined");
const original = createCalendar({ timeZone: "Asia/Tokyo" });
const changed = executeCalendarCommands(original, { type: "event.create", event: { id: "review", title: "Headless event", allDay: false, start: "2026-09-22T09:00:00+09:00", end: "2026-09-22T10:00:00+09:00" } }).calendar;
assert.equal(original.events.length, 0); assert.equal(changed.events.length, 1);
assert.deepEqual(parseCalendar(serializeCalendar(changed)), changed);
const range = getCalendarVisibleRange("2026-09-22", "day", "Asia/Tokyo");
assert.equal(getCalendarEvents(changed, range).length, 1);
const moved = executeCalendarCommands(changed, createCalendarRescheduleCommand(changed, "review", "2026-09-23")).calendar;
assert.equal(moved.events[0].start, "2026-09-23T00:00:00.000Z");
assert.throws(() => executeCalendarCommands(changed, [{ type: "calendar.update", title: "Partial" }, { type: "event.delete", id: "missing" }]));
assert.equal(changed.title, original.title);
assert.throws(() => parseCalendar(JSON.stringify({ ...changed, version: 2 })));
console.log(JSON.stringify({ noReact: true, noDOM: true, commands: "passed", nativeRoundtrip: "passed" }));
