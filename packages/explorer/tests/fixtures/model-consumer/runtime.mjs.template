import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import {
  createDraftSnapshot, applyAction, addFilesWithResult, addFilesWithResultAsync, addFilesAsync, prepareFilesWithProgress,
  createExplorerUploadSession, ExplorerUploadConflictError, getSavePayload, hasChanges,
  ExplorerUploadValidationError, ExplorerUploadInspectionRequiredError,
  EXPLORER_DEFAULT_MAX_VIDEO_DURATION_SECONDS, describeEntries, resolveExplorerEntryTargets, readEntryFile,
  assertExplorerEntryPermissions, checksForExplorerAction, ExplorerOperationDeniedError,
  resolveExplorerSearchHits, resolveExplorerSearchIds,
  mergeExplorerFolderEntries, mergeExplorerSearchEntries,
  inspectExplorerUploadFile, EXPLORER_DEFAULT_PDF_INSPECTION_LIMITS,
} from '__MODEL_IMPORT__';

const require = createRequire(import.meta.url);
assert.throws(() => require.resolve('react'), { code: 'MODULE_NOT_FOUND' });
assert.throws(() => require.resolve('react-dom'), { code: 'MODULE_NOT_FOUND' });
assert.equal(typeof window, 'undefined');
assert.equal(typeof document, 'undefined');
const baseline = createDraftSnapshot([]);
const folder = applyAction(baseline, { action: 'create', name: 'Documents' });
const parent = folder.entries[0].id;
const cached = createDraftSnapshot(folder.entries);
const locallyRenamed = applyAction(cached, { action: 'rename', ids: [parent], name: 'Local documents' });
const remoteChild = { id: 'remote-child', parent, name: 'Server.txt', kind: 'file', size: 10, mime: 'text/plain',
  createdAt: '2026-10-03T00:00:00Z', updatedAt: '2026-10-03T00:00:00Z', favorite: 0, source: { kind: 'existing', id: 'blob-remote' } };
const hydrated = mergeExplorerFolderEntries(cached, locallyRenamed, parent, [remoteChild]);
assert.equal(hydrated.addedCount, 1);
assert.equal(hydrated.draft.entries.find(entry => entry.id === parent).name, 'Local documents');
const hydrationChanges = getSavePayload(hydrated.baseline, hydrated.draft).changes;
assert.deepEqual(hydrationChanges.created, []);
assert.deepEqual(hydrationChanges.updated.map(entry => entry.id), [parent]);
assert.equal(cached.entries.length, 1);
assert.throws(() => mergeExplorerFolderEntries(cached, locallyRenamed, parent, [{ ...remoteChild, parent: 'root' }]), /直下/);
remoteChild.name = 'Caller changed.txt';
assert.equal(hydrated.draft.entries.find(entry => entry.id === 'remote-child').name, 'Server.txt');
const remoteFolder = { ...folder.entries[0], id: 'search-folder', name: 'Search folder' };
const remoteMatch = { ...remoteChild, id: 'search-match', parent: remoteFolder.id, name: 'Search match.txt' };
const searched = mergeExplorerSearchEntries(cached, locallyRenamed, [remoteMatch, remoteFolder]);
assert.equal(searched.addedCount, 2);
assert.equal(searched.draft.entries.find(entry => entry.id === parent).name, 'Local documents');
assert.deepEqual(getSavePayload(searched.baseline, searched.draft).changes.created, []);
assert.throws(() => mergeExplorerSearchEntries(cached, locallyRenamed, [remoteMatch]));
const file = new File(['first'], 'report.txt', { type: 'text/plain' });
const added = addFilesWithResult(folder, [file], parent);
const id = added.snapshot.entries.find(entry => entry.kind === 'file').id;
const hitMetadata = { customer: { name: '顧客A' }, meetingDate: '2026-09-15' };
const searchResponse = [{ entryId: id, snippet: '料金改定について合意', reason: '本文に一致', metadata: hitMetadata }, id, 'unknown'];
const searchHits = resolveExplorerSearchHits(searchResponse, added.snapshot.entries);
assert.equal(searchHits.length, 1);
assert.equal(searchHits[0].entryId, id);
assert.equal(searchHits[0].snippet, '料金改定について合意');
assert.equal(Object.isFrozen(searchHits), true);
assert.equal(Object.isFrozen(searchHits[0].metadata.customer), true);
hitMetadata.customer.name = '後から変更';
assert.equal(searchHits[0].metadata.customer.name, '顧客A');
assert.deepEqual(resolveExplorerSearchIds(searchResponse, added.snapshot.entries), [id]);
const permissionChecks = checksForExplorerAction(added.snapshot.entries, { action: 'delete', ids: [parent] });
let locked = true;
const getEntryPermissions = entry => entry.id === id && locked ? { delete: { allowed: false, message: '編集中です' } } : undefined;
assert.throws(() => assertExplorerEntryPermissions(added.snapshot.entries, permissionChecks, getEntryPermissions),
  error => error instanceof ExplorerOperationDeniedError && error.entryId === id && error.operation === 'delete' && error.message === '編集中です');
locked = false;
assertExplorerEntryPermissions(added.snapshot.entries, permissionChecks, getEntryPermissions);
assert.equal(added.result.addedCount, 1);
assert.equal(await (await readEntryFile(added.snapshot.entries.find(entry => entry.id === id))).text(), 'first');
assert.equal(hasChanges(baseline, added.snapshot), true);
assert.equal(getSavePayload(baseline, added.snapshot).changes.created.length, 2);
assert.deepEqual(baseline.entries, []);
assert.throws(() => applyAction(added.snapshot, { action: 'rename', ids: [id], name: 'report.csv' }), /拡張子/);
const renamed = applyAction(added.snapshot, { action: 'rename', ids: [id], name: 'renamed.txt' });
assert.equal(describeEntries(renamed.entries).find(entry => entry.id === id).path, '/Documents/renamed.txt');
assert.deepEqual(resolveExplorerEntryTargets(renamed.entries, [{ id: parent }, { id }]).value.entryIds, [parent, id]);
const replacement = new File(['second'], 'renamed.txt', { type: 'text/plain' });
const session = createExplorerUploadSession();
let conflict;
try { addFilesWithResult(renamed, [replacement], parent, undefined, [], session); }
catch (error) { assert.ok(error instanceof ExplorerUploadConflictError); conflict = error.conflict; }
assert.ok(conflict);
assert.equal(renamed.entries.find(entry => entry.id === id).source.file, file);
const staged = prepareFilesWithProgress(renamed, [replacement], parent, undefined,
  [{ fileIndex: conflict.fileIndex, existing: conflict.existing, action: 'overwrite' }], session);
let progress = 0, result;
for (;;) { const step = staged.next(); if (step.done) { result = step.value; break; } progress++; }
assert.ok(progress > 0);
assert.equal(result.result.overwrittenCount, 1);
assert.equal(result.snapshot.entries.find(entry => entry.id === id).source.file, replacement);
assert.equal(renamed.entries.find(entry => entry.id === id).source.file, file);
const video = new File(['video metadata supplied by the host'], 'clip.mp4');
assert.throws(() => addFilesWithResult(baseline, [video], 'root'), ExplorerUploadInspectionRequiredError);
const videoSnapshot = await addFilesAsync(baseline, [video], 'root', {
  inspectFile: () => ({ kind: 'video', durationSeconds: EXPLORER_DEFAULT_MAX_VIDEO_DURATION_SECONDS }),
});
assert.equal(videoSnapshot.entries[0].source.file, video);
await assert.rejects(() => addFilesWithResultAsync(baseline, [video], 'root', {
  inspectFile: () => ({ kind: 'video', durationSeconds: EXPLORER_DEFAULT_MAX_VIDEO_DURATION_SECONDS + 1 }),
}), error => error instanceof ExplorerUploadValidationError && error.rejections[0].reasons[0].code === 'duration-exceeded');
// Independent, real cross-reference fixture; consumers need no PDF generator.
let pdf = '%PDF-1.7\n';
const offsets = [0];
for (const [index, body] of [
  '<< /Type /Catalog /Pages 2 0 R >>',
  '<< /Type /Pages /Kids [3 0 R 4 0 R] /Count 2 >>',
  '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] >>',
  '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] >>',
].entries()) { offsets.push(pdf.length); pdf += `${index + 1} 0 obj\n${body}\nendobj\n`; }
const xref = pdf.length;
pdf += `xref\n0 5\n0000000000 65535 f \n${offsets.slice(1).map(offset => `${String(offset).padStart(10, '0')} 00000 n \n`).join('')}trailer\n<< /Size 5 /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF\n`;
const pdfFile = new File([pdf], 'two-pages.pdf', { type: 'application/pdf' });
assert.equal(EXPLORER_DEFAULT_PDF_INSPECTION_LIMITS.inputBytes, 100 * 1024 * 1024);
assert.equal(EXPLORER_DEFAULT_PDF_INSPECTION_LIMITS.timeoutMs, 30_000);
assert.equal(Object.isFrozen(EXPLORER_DEFAULT_PDF_INSPECTION_LIMITS), true);
const pdfRequest = { file: pdfFile, kind: 'pdf', extension: '.pdf', signal: new AbortController().signal };
await assert.rejects(inspectExplorerUploadFile({ ...pdfRequest, pdfInspectionLimits: { inputBytes: pdfFile.size - 1 } }), /PDF/);
assert.deepEqual(await inspectExplorerUploadFile({ ...pdfRequest, pdfInspectionLimits: { inputBytes: pdfFile.size } }), { kind: 'pdf', pages: 2 });
assert.deepEqual(await inspectExplorerUploadFile(pdfRequest), { kind: 'pdf', pages: 2 });
await assert.rejects(() => addFilesWithResultAsync(baseline, [pdfFile], 'root', {
  contentLimitsByExtension: { '.pdf': { maxPages: 2 } },
  pdfInspectionLimits: { inputBytes: pdfFile.size - 1 },
}), error => error instanceof ExplorerUploadValidationError && error.rejections[0].reasons[0].code === 'content-inspection-failed');
assert.deepEqual(baseline.entries, []);
await assert.rejects(() => addFilesWithResultAsync(baseline, [pdfFile], 'root', {
  contentLimitsByExtension: { '.pdf': { maxPages: 1 } },
}), error => error instanceof ExplorerUploadValidationError && error.rejections[0].reasons[0].pages === 2);
const pdfResult = await addFilesWithResultAsync(baseline, [pdfFile], 'root', {
  contentLimitsByExtension: { '.pdf': { maxPages: 2 } },
  pdfInspectionLimits: { inputBytes: pdfFile.size },
});
assert.equal(pdfResult.result.addedCount, 1);
assert.equal(pdfResult.snapshot.entries[0].source.file, pdfFile);
assert.deepEqual(baseline.entries, []);
assert.equal(typeof document, 'undefined');
console.log(JSON.stringify({ model: 'explorer', entries: result.snapshot.entries.length, overwrite: result.result.overwrittenCount,
  contentValidation: { videoDuration: EXPLORER_DEFAULT_MAX_VIDEO_DURATION_SECONDS, pdfPages: 2, configurablePdfInspection: true }, entryPermissions: true, reactFree: true }));
