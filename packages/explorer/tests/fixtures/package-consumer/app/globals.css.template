/* Ordinary host styles; no Tailwind or PostCSS plugin is configured. */
body { margin: 0; font-family: system-ui, sans-serif; }
main > h1 { margin: 1rem; }

/* Existing application utilities deliberately have different meanings. These
 * names must not match the Explorer's lxe: utilities. */
.flex { display: grid; }
.min-h-0 { min-height: 3rem; }
.h-8 { height: 5rem; }
.host-probe { margin: 1rem; padding: 0.5rem; border: 3px solid rebeccapurple; }
button, input {
  font-family: Georgia, serif;
  font-size: 28px;
  padding: 24px;
  border: 5px dotted crimson;
  background: mistyrose;
  color: crimson;
}
