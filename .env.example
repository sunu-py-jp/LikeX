# Playground AI demos: /spreadsheet/ai and /slide/ai
# Copy to .env at the repository root and restart npm run dev after editing.
# These settings are read by the server only. Never prefix API keys with VITE_.
# Tool execution logs are saved locally in .likex-ai/runs/<run-id>.jsonl (gitignored).
# No extra environment setting is needed for logging; the repository must be writable.
AI_PROVIDER=openai

# OpenAI: a model supporting Responses API function calling.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional: omit to keep the model's default reasoning effort.
# Supported values are model-dependent: none|minimal|low|medium|high|xhigh|max.
# AI_REASONING_EFFORT=medium

# Azure OpenAI: set AI_PROVIDER=azure and fill these three values.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-responses-deployment
# Optional: legacy /openai/responses API instead of /openai/v1/responses.
# Omit for v1. If set, the version must support Responses (e.g. 2025-04-01-preview).
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
